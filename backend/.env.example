# Copia este archivo a .env y rellénalo. .env nunca se versiona (RN-04).

PORT=3000

# Token fijo entre el reloj y el backend — andamio de la etapa 2 (PRD §12), lo sustituye la
# vinculación de la etapa 4. Genera uno con:  node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# El mismo valor va en local.properties del proyecto Android como voicenoteai.devApiToken.
DEV_API_TOKEN=

# Cliente OAuth de tipo «Aplicación web» (PRD §3.4). Ver README → «Google Cloud».
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Tu refresh token, obtenido una sola vez con:  npm run refresh-token
GOOGLE_REFRESH_TOKEN=

# Google AI Studio → Get API key. Si se deja vacío, las notas se guardan sin estructurar (FA-11).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Zona horaria para resolver «mañana», «el viernes»… del dictado. Por defecto America/Bogota.
# TIME_ZONE=America/Bogota
