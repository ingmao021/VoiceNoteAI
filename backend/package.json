{
  "name": "voicenoteai-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "refresh-token": "tsx --env-file=.env scripts/get-refresh-token.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.1",
    "@google/genai": "^2.27.0",
    "@googleapis/tasks": "^17.0.1",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
