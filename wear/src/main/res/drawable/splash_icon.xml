<?xml version="1.0" encoding="utf-8"?>
<!-- Icono de la app en la pantalla de inicio: círculo verde oscuro y, encima, el primer plano del icono
     adaptativo, cuyo contenido ocupa los 2/3 centrales (por eso 72 dp sobre un círculo de 48 dp). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="48dp"
        android:height="48dp"
        android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="30dp"
                android:startColor="@color/ic_launcher_background_center"
                android:endColor="@color/ic_launcher_background" />
        </shape>
    </item>
    <item
        android:width="72dp"
        android:height="72dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
